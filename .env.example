# HCode is BYOK: configure your model provider and API key in Settings.
# Hosted account/business/relay services are not bundled. These reserved domains are not live services.
# Legacy variable names remain until the coordinated runtime/config migration.
ZCODE_BASE_URL=https://services.hcode.invalid
BIGMODEL_API_BASE_URL=https://accounts.hcode.invalid
ZAI_OAUTH_ORIGIN=https://auth.hcode.invalid
ZAI_BUSINESS_BASE_URL=https://business.hcode.invalid
ZAI_OAUTH_CLIENT_ID=

# Optional self-hosted service configuration; uncomment and use your own deployment.
# ZCODE_CONVERSATION_SHARE_WEB_URL=https://your-host.example/cn/share
# Full remote-runtime URL must include the matching version. No upstream CDN fallback.
# ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://your-host.example/releases/3.15.1

# Optional local provider config; otherwise use the bundled BYOK-only configuration.
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
